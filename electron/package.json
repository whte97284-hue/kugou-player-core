{
    "name": "kugou-decoder",
    "version": "2.2.0",
    "description": "酷狗音频解码终端 - KGM/KGG 加密音频解密工具",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "build": "electron-builder"
    },
    "author": "酷狗解码工具",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.kugou.decoder",
        "productName": "酷狗音频解码终端",
        "directories": {
            "output": "../dist-electron"
        },
        "files": [
            "main.js",
            "preload.js",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../flask-dist/KugouDecoder",
                "to": "flask",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "../static/icon.png"
        },
        "portable": {
            "artifactName": "酷狗音频解码器-${version}.exe"
        }
    }
}